.claude/
.DS_Store

# Python tooling
__pycache__/
.pytest_cache/
.venv/
*.pyc

# User personal samples (never committed)
writing-samples/

# Personal-mode eval reports — never committed
evals/reports/*_personal_*
evals/reports/personal_*

# Eval report archive (keep only the most recent summary in tree)
evals/reports/*.json
evals/reports/*.md
!evals/reports/.gitkeep
!evals/reports/summary_latest_en.md
!evals/reports/summary_latest_en.json

# Per-case E2E partial caches — regenerable, user-session-specific
evals/reports/_partial/

# DE corpus — research-only fair-use excerpts (per docs/de-corpus-sources.md, kept local, not redistributed)
evals/corpus/de/human/research_only/
